BIND_ADDR=0.0.0.0:8080
POSTGRES_PASSWORD=change-me
DOMAIN=graphwar.tiendepchai.id.vn
CLOUDFLARE_TUNNEL_TOKEN_FILE=./cloudflare-tunnel-token
DATABASE_MAX_CONNECTIONS=10
ALLOWED_ORIGINS=https://graphwar.tiendepchai.id.vn
SECURE_COOKIES=true
SESSION_TTL_SECONDS=2592000
GRAPHWAR_STATIC_DIR=/app/assets/web
RUST_LOG=graphwar_server=info,tower_http=info

# Keep cloudflare-tunnel-token outside Git. Cloudflare Public Hostname must route
# graphwar.tiendepchai.id.vn to http://127.0.0.1:18081.
